# Local development only. Create a unique password before starting Compose.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://groundzero:replace-with-a-local-password@127.0.0.1:5432/groundzero?schema=public
# Disabled by default; only works with npm run dev, never next start.
DEV_AUTH_ENABLED=false
# Generate with: openssl rand -hex 32
DEV_AUTH_SECRET=

# Passkeys: use localhost (not 127.0.0.1) for WebAuthn + Secure cookies locally.
AUTH_REGISTRATION_ENABLED=false
AUTH_ORIGIN=http://localhost:3000
AUTH_RP_ID=localhost
# Generate separately: openssl rand -hex 32. Changing this invalidates old codes.
RECOVERY_CODE_KEY=
# Enforced minimum 24; maximum 48 hours, within the 72-hour attempt lifetime.
RECOVERY_DELAY_HOURS=24
