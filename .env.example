# Local development only. Create a unique password before starting Compose.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://groundzero:replace-with-a-local-password@127.0.0.1:5432/groundzero?schema=public
# Disabled by default; only works with npm run dev, never next start.
DEV_AUTH_ENABLED=false
# Generate with: openssl rand -hex 32
DEV_AUTH_SECRET=
